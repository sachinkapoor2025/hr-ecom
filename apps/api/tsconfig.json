{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/* 2.ts",
    "src/**/* 2.tsx",
    "src/**/* 2.json",
    "src/**/* 3.ts",
    "src/**/* 3.tsx"
  ]
}
